rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo le due persone autorizzate (sostituisci le email con quelle vere) possono leggere e scrivere i lead.
    // Tutto il resto del database è chiuso.
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email in ['emilianocarlotti@alice.it', 'lrnz.crlt@gmail.com'];
    }
    match /leads/{leadId} {
      allow read: if autorizzato();
      allow create, update: if autorizzato()
        && request.resource.data.id == leadId
        && request.resource.data.keys().size() < 20;
      allow delete: if false;   // le cancellazioni sono "tombstone" (solo l'id), mai hard delete
    }
    // Foto del sopralluogo: una foto compressa per documento (max ~1 MB), legata a un lead
    match /photos/{photoId} {
      allow read, delete: if autorizzato();
      allow create: if autorizzato()
        && request.resource.data.id == photoId
        && request.resource.data.leadId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
    }
  }
}
